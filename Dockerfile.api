# syntax=docker/dockerfile:1.7
FROM golang:1.27-alpine AS build
WORKDIR /src
RUN apk add --no-cache ca-certificates git
COPY go.mod go.sum* ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
COPY migrations ./migrations
ADD --chmod=644 --checksum=sha256:a32bb3c384bd3de60ad9024596aa5b395a6dd5beaa27a7223407cc2edc681d0b https://download.db-ip.com/free/dbip-country-lite-2026-09.csv.gz /data/dbip-country-lite.csv.gz
RUN go test ./...
ARG NERVE_VERSION=dev
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w -X main.version=${NERVE_VERSION}" -o /out/nerve-server ./cmd/nerve-server

FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /app
COPY --from=build /out/nerve-server /app/nerve-server
COPY migrations /app/migrations
COPY --from=build /data /app/data
EXPOSE 8080
USER nonroot:nonroot
ENTRYPOINT ["/app/nerve-server"]
