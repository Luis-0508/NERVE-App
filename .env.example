# setup.bat creates local secrets and selects a free web port without questions.
# traffic-sensor-setup.bat configures the optional traffic extension separately.
NERVE_HTTP_ADDR=:8080
NERVE_DATABASE_URL=postgres://nerve:change-me@postgres:5432/nerve?sslmode=disable
NERVE_MIGRATIONS_DIR=/app/migrations
NERVE_COOKIE_SECURE=false
NERVE_TRUST_PROXY=true
NERVE_ALLOWED_ORIGIN=http://localhost:3000
NERVE_SESSION_TTL=24h
# How long remote command output is kept (Go duration such as 720h, or days such as 30d).
NERVE_COMMAND_RESULT_RETENTION=30d
NERVE_LOG_LEVEL=info
NERVE_DISCOVERY_AGENT_TOKEN=change-me
# Ed25519 seed (64 hex) that signs every agent-API response; agents pin its
# fingerprint at enrollment. setup.bat generates it. Changing it requires re-enrolling agents.
NERVE_CORE_SIGNING_KEY=
# Windows setup automatically enables native host capture; no external sensor required.
# Docker Desktop cannot capture Windows/LAN packets by adding a Linux container.
NERVE_TRAFFIC_CAPTURE_MODE=
# Modes: windows-native, sensor-required, external, linux-interface; empty derives from source URL.
NERVE_SENSOR_TOKEN=
# Separate authenticated ingest, published only on 127.0.0.1; setup selects a free port.
NERVE_SENSOR_PORT=
NERVE_NTOPNG_URL=
NERVE_NTOPNG_USERNAME=
NERVE_NTOPNG_PASSWORD=
NERVE_NTOPNG_INTERFACE_ID=0
# New sources use auto when exactly one ntopng interface exists; existing IDs remain valid.
NERVE_NTOPNG_TIMEOUT=5s
# Optional comma-separated extra local ranges (private IPv4/IPv6 are detected automatically).
NERVE_TRAFFIC_LOCAL_CIDRS=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NERVE_WEB_PORT=3000
POSTGRES_DB=nerve
POSTGRES_USER=nerve
POSTGRES_PASSWORD=change-me
# ntopng URL must be reachable FROM the API container. localhost there is the API itself.
# Docker Desktop host example: http://host.docker.internal:3001 (use your actual ntopng port).
# Use single quotes around passwords containing $ or # to prevent Compose interpolation.
# After editing: docker compose up -d --force-recreate api
# Diagnose using exactly the API container environment:
# docker compose exec api /app/nerve-server traffic-check
